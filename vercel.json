{
  "rewrites": [
    {
      "source": "/preview",
      "destination": "/preview.html"
    },
    {
      "source": "/preview/:id",
      "destination": "/preview.html"
    }
  ],
  "redirects": [
    {
      "source": "/album/:id",
      "destination": "/preview.html",
      "statusCode": 302
    }
  ]
}
